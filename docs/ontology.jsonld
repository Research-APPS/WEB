          "@id": "mf:dinamico",
          "mf:relationLabel": "recomienda tipo"
        },
        {
          "@id": "mf:condensador-diafragma-pequeno",
          "mf:relationLabel": "recomienda tipo"
        },
        {
          "@id": "mf:xy",
          "mf:relationLabel": "recomienda técnica"
        },
        {
          "@id": "mf:ab",
          "mf:relationLabel": "recomienda técnica"
        }
      ]
    },
    {
      "@id": "mf:ampli-guitarra-electrica",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@language": "es",
        "@value": "Amplificador de guitarra eléctrica"
      },
      "skos:altLabel": {
        "@language": "en",
        "@value": "Electric guitar amp"
      },
      "skos:definition": {
        "@language": "es",
        "@value": "Dinámico pegado a la rejilla del altavoz. Apuntar al centro del cono da un sonido más agresivo/nasal; apuntar cerca del borde ('cap edge') da más brillo y menos distorsión de proximidad. Se puede combinar con un condensador algo más retirado para capturar la sala."
      },
      "skos:inScheme": {
        "@id": "mf:MicrofoniaScheme"
      },
      "skos:member": {
        "@id": "mf:cat-instrumentos"
      },
      "mf:hasProperty": [
        {
          "mf:propertyName": "Micrófono recomendado",
          "mf:propertyValue": "Dinámico (clásico: cápsula tipo SM57)"
        },
        {
          "mf:propertyName": "Posición",
          "mf:propertyValue": "Pegado a la rejilla, entre el centro y el borde del cono"
        },
        {
          "mf:propertyName": "Combinación habitual",
          "mf:propertyValue": "+ condensador a 1-2 metros para ambiente"
        }
      ],
      "skos:related": [
        {
          "@id": "mf:dinamico"
        }
      ],
      "mf:relation": [
        {
          "@id": "mf:dinamico",
          "mf:relationLabel": "recomienda tipo"
        }
      ]
    },
    {
      "@id": "mf:piano",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@language": "es",
        "@value": "Piano (de cola)"
      },
      "skos:altLabel": {
        "@language": "en",
        "@value": "Grand piano"
      },
      "skos:definition": {
        "@language": "es",
        "@value": "Con la tapa apoyada en el palillo largo, un par estéreo de condensadores apunta uno hacia las cuerdas graves y otro hacia las agudas. Para escenario, un micrófono de superficie dentro de la caja evita problemas de feedback."
      },
      "skos:inScheme": {
        "@id": "mf:MicrofoniaScheme"
      },
      "skos:member": {
        "@id": "mf:cat-instrumentos"
      },
      "mf:hasProperty": [
        {
          "mf:propertyName": "Grabación",
          "mf:propertyValue": "Par estéreo de condensadores (AB u ORTF), tapa apoyada en palillo largo"
        },
        {
          "mf:propertyName": "Directo/escenario",
          "mf:propertyValue": "Micrófono de superficie (PZM) dentro de la caja"
        }
      ],
      "skos:related": [
        {
          "@id": "mf:ab"
        },
        {
          "@id": "mf:pzm-boundary"
        }
      ],
      "mf:relation": [
        {
          "@id": "mf:ab",
          "mf:relationLabel": "recomienda técnica"
        },
        {
          "@id": "mf:pzm-boundary",
          "mf:relationLabel": "recomienda tipo"
        }
      ]
    }
  ]
}